OPEN_ROUTER_API_KEY=your-openrouter-key-here
MODEL=cohere/north-mini-code:free
MODEL_PROVIDER=openrouter
MODEL_TEMPERATURE=0.8

# behaviour knobs
EVAL_TIMEOUT_SECONDS=300
MIN_TEST_CASES=20
EVALUATE_BY_DEFAULT=true

# file locations (relative to the repo root)
TRACKER_FILE=tracker.json
SOLUTION_APPROACH_FILE=solution_approach.md
KB_FILE=kb/coding_patterns.md

# langsmith values (optional tracing)
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your-langsmith-key-here
LANGSMITH_PROJECT="evaluation_agent"
